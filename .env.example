# Docker Update Orchestrator - Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# LLM Configuration
# ======================

# Anthropic (Claude) - Recommended for best analysis
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT)
OPENAI_API_KEY=sk-your-key-here

# Google (Gemini)
GEMINI_API_KEY=your-key-here

# Ollama (Local) - Free, no API needed
# If using Ollama, it should be running on localhost:11434
# Install: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434

# Primary LLM to use
LLM_PROVIDER=anthropic
LLM_MODEL_PRIMARY=claude-3-5-sonnet-20241022
LLM_MODEL_FALLBACK=gpt-4-turbo-preview
LLM_MODEL_LOCAL=llama2

# Use local LLM for sensitive/internal services
USE_LOCAL_FOR_SENSITIVE=true

# ======================
# Notification Settings
# ======================

# NTFY - Free push notifications
NTFY_ENABLED=true
NTFY_TOPIC=docker-updates
NTFY_SERVER=https://ntfy.sh

# Email Notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=admin@example.com,team@example.com

# Webhooks
WEBHOOK_ENABLED=false
WEBHOOK_URLS=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ======================
# Docker Server List
# ======================

# Comma-separated list of server names
DOCKER_SERVERS=workhorse1,workhorse2,minideb,mediabeelink,hetzner-vps

# SSH Configuration
SSH_KEY_PATH=/root/.ssh/id_rsa
SSH_USERNAME=root
SSH_PORT=22

# ======================
# Update Settings
# ======================

# How often to check for updates (hours)
UPDATE_CHECK_INTERVAL_HOURS=6

# Maximum number of updates to run concurrently
MAX_CONCURRENT_UPDATES=3

# Health check timeout (seconds)
HEALTH_CHECK_TIMEOUT_SECONDS=300

# Number of health check retries
HEALTH_CHECK_RETRIES=3

# Auto-rollback on failure
ROLLBACK_ON_FAILURE=true

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ======================
# Security
# ======================

# Secret key for JWT tokens (change this!)
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# CORS Origins (for frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ======================
# Database
# ======================

# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@postgres:5432/orchestrator
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ======================
# Redis / Celery
# ======================

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ======================
# Application
# ======================

# Environment: development, production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Prometheus monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
